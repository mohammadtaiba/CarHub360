<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="myPU" transaction-type="JTA">
        <jta-data-source>java:jboss/datasources/ExampleDS</jta-data-source>

        <class>de.fherfurt.carhub360.contract.Contract</class>
        <class>de.fherfurt.carhub360.customer.Customer</class>
        <class>de.fherfurt.carhub360.customer.address.CustomerAddress</class>
        <class>de.fherfurt.carhub360.customer.history.CustomerHistory</class>
        <class>de.fherfurt.carhub360.maintenance.Maintenance</class>
        <class>de.fherfurt.carhub360.payment.Payment</class>
        <class>de.fherfurt.carhub360.vehicle.rent.RentVehicle</class>
        <class>de.fherfurt.carhub360.vehicle.sale.SaleVehicle</class>
        <class>de.fherfurt.carhub360.vehicle.Vehicle</class>

        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
